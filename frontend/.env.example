# Option A (recommended local dev): omit VITE_API_BASE_URL — the dev server proxies /api → FastAPI.
# Option B: set a full origin to call the API directly (no proxy).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# If your API runs elsewhere in dev, point the proxy at it:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

