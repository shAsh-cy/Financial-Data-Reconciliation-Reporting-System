# Option A (recommended local dev): omit VITE_API_BASE_URL — the dev server proxies /api → FastAPI.
# Option B: set origin ONLY (no /api/v1 suffix — the client adds /api/v1/... itself).
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Wrong: VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1  → breaks with 404 on detail routes.

# If your API runs elsewhere in dev, point the proxy at it:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

