# Application
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# Reporting APIs: when true and DB has no rows (or matching demo IDs), responses may include deterministic demo data (meta.is_demo=true)
REPORTING_DEMO_FALLBACK=true

# Database (use postgresql+asyncpg:// for async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financial_reconciliation
DATABASE_ECHO=false

# Auth (JWT)
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_RETRY_DELAY=60
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=true
CELERY_TASK_RETRY_BACKOFF_MAX=600

# Frontend (these belong in frontend/.env, not this file — see frontend/.env.example)
#
# VITE_API_BASE_URL must be an ORIGIN ONLY. The axios client already appends
# /api/v1/... to every path, so including that suffix here produces
# /api/v1/api/v1/... and every detail route 404s.
#   Correct:  VITE_API_BASE_URL=http://127.0.0.1:8000
#   Wrong:    VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Leaving it unset is preferred in dev: Vite proxies /api -> FastAPI.
# frontend/src/utils/env.ts defensively strips a trailing /api/v1 if present.
#
# VITE_DEMO_MODE=true forces the app-wide demo banner on.

# Docker Compose (production-like local)
# Set these when using docker-compose; do not commit real values.
# POSTGRES_USER=app
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=financial_reconciliation
# JWT_SECRET_KEY=your-secret-key-min-32-chars
# FRONTEND_PORT=80
